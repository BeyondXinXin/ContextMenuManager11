<Window x:Class="ContextMenuManager11.App.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单项属性"
        Height="540"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="菜单项详细信息"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.DisplayName}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="状态" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.StatusText}" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="状态说明" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.VisibilityDetail}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="作用范围" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.ScopeText}" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="菜单类型" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.KindText}" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="来源 HKCU/HKLM" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.RootText}" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="注册表路径" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.RegistryPath}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="禁用后路径" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.DisabledRegistryPath}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="命令" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.Command}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="图标" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.Icon}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="CLSID" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.Clsid}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="风险等级" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.RiskLevel}" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="最后修改时间" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,2" />
                <TextBlock Text="{Binding Item.LastModifiedTime}" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="关闭"
                Width="80"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="Close_Click" />
    </Grid>
</Window>
