<Window x:Class="ContextMenuManager11.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ContextMenuManager11"
        Height="760"
        MinHeight="560"
        Width="1180"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主内容区：两栏布局 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：分类导航 ===== -->
            <Border Grid.Column="0"
                    Background="#F7F9FB"
                    BorderBrush="{StaticResource BorderBrushMuted}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 分类列表 -->
                    <ListBox x:Name="NavListBox"
                             Grid.Row="0"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="0,12,0,0"
                             Padding="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="40" />
                                <Setter Property="Padding" Value="20,0,12,0" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="6"
                                                    Margin="8,1,8,1">
                                                <ContentPresenter HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource NavSelectedTextBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 底部：重启 Explorer 按钮 -->
                    <Border Grid.Row="1"
                            Padding="8,8,8,12"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="0,1,0,0">
                        <Button Content="🔄 重启 Explorer"
                                Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RestartExplorerCommand}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 中间：主内容区 ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 菜单列表页面 -->
                <Grid Grid.RowSpan="2" Visibility="{Binding ListPageVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 搜索 + 筛选栏 -->
                    <Border Grid.Row="0"
                            Padding="16,14,16,10"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="0"
                                     Text="{Binding List.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="搜索名称、命令、图标、CLSID、注册表路径"
                                     Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding List.StatusOptions}"
                                          SelectedItem="{Binding List.StatusFilter}"
                                          Width="80"
                                          Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding List.RootOptions}"
                                          SelectedItem="{Binding List.RootFilter}"
                                          Width="80"
                                          Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding List.KindOptions}"
                                          SelectedItem="{Binding List.KindFilter}"
                                          Width="90" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 列标题（匹配 ListView 列宽，与数据行对齐） -->
                    <Border Grid.Row="1"
                            Padding="12,0"
                            Background="#F7F9FB"
                            BorderBrush="{StaticResource BorderBrushMuted}"
                            BorderThickness="0,0,0,1">
                        <Grid Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="图标" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBlock Grid.Column="1" Text="名称" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="2" Text="描述" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="3" Text="服务路径" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <TextBlock Grid.Column="4" Text="开关" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 列表 -->
                    <ListView x:Name="ItemListView"
                              Grid.Row="2"
                              ItemsSource="{Binding List.FilteredItems}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              Margin="8,0,8,8"
                              MouseDoubleClick="ItemListView_MouseDoubleClick"
                              PreviewMouseRightButtonDown="ItemListView_PreviewMouseRightButtonDown"
                              PreviewKeyDown="ItemListView_PreviewKeyDown"
                              SelectionMode="Extended">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑" Click="ContextMenu_Edit_Click" />
                                <MenuItem Header="属性" Click="ContextMenu_Properties_Click" />
                                <Separator />
                                <MenuItem Header="打开注册表" Click="ContextMenu_OpenRegistry_Click" />
                                <MenuItem Header="打开文件位置" Click="ContextMenu_OpenFileLocation_Click" />
                                <Separator />
                                <MenuItem Header="删除" Click="ContextMenu_Delete_Click" />
                                <Separator />
                                <MenuItem Header="刷新" Click="ContextMenu_Refresh_Click" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <!-- 图标 -->
                                <GridViewColumn Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding IconSourcePath, Converter={StaticResource IconConverter}}"
                                                   Width="20" Height="20"
                                                   Stretch="Uniform"
                                                   Margin="6,0"
                                                   VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 名称 -->
                                <GridViewColumn Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 描述 -->
                                <GridViewColumn Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 服务路径 -->
                                <GridViewColumn Width="Auto">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ServicePath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"
                                                       ToolTip="{Binding ServicePath}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 开关 -->
                                <GridViewColumn Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="ToggleSwitch_Click" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- Win11 设置页面 -->
                <Grid Grid.Row="1" Visibility="{Binding Win11PageVisibility}" Margin="48,32">
                    <StackPanel Width="560" HorizontalAlignment="Left">
                        <TextBlock Text="Win11 经典右键菜单设置"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="控制是否默认使用 Windows 10 风格的经典右键菜单。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24" />

                        <Border Background="#F7F9FB"
                                CornerRadius="8"
                                Padding="20"
                                BorderBrush="{StaticResource BorderBrushMuted}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="默认使用经典右键菜单"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="启用后，右键将显示完整的经典上下文菜单而非 Win11 简化版。"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsClassicContextMenuEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="修改后需要重启 Explorer 才能生效。"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,14,0,24" />
                        <Button Content="🔄 重启 Explorer"
                                Width="140"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding RestartExplorerCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1"
                Height="32"
                Background="#F2F4F7"
                BorderBrush="{StaticResource BorderBrushMuted}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
